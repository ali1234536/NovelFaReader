                                            </Grid>
                                            <Grid Visibility="{DynamicResource ThemeJuliusVisibility}" IsHitTestVisible="False">
                                                <Path Data="M0,12 L0,0 L12,0 M4,12 L4,4 L12,4" Stroke="#F4D26B" StrokeThickness="1.6" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" Stretch="None" />
                                                <Path Data="M0,12 L0,0 L12,0 M4,12 L4,4 L12,4" Stroke="#F4D26B" StrokeThickness="1.6" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Stretch="None" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform></Path>
                                                <Path Data="M0,12 L0,0 L12,0 M4,12 L4,4 L12,4" Stroke="#F4D26B" StrokeThickness="1.6" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3" Stretch="None" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform></Path>
                                                <Path Data="M0,12 L0,0 L12,0 M4,12 L4,4 L12,4" Stroke="#F4D26B" StrokeThickness="1.6" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" Stretch="None" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform></Path>
                                            </Grid>
                                            <Button Name="MoreBtn" Opacity="0" Style="{StaticResource CardIconButton}" Background="#F2FFFFFF" Foreground="#4C4766" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Tag="{Binding}" Click="BtnMore_Click">
                                                <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoDots}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="MoreBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3" />
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" />
                                                    <DoubleAnimation Storyboard.TargetName="MoreBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Grid Name="collectionsPanel" Grid.Row="2" Margin="36,8,36,12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style x:Key="CollectionItemStyle" TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="CollectionRowTemplate">
                        <Border CornerRadius="12" BorderThickness="1" Padding="16,12" Margin="0,0,0,8" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextColor}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding AddText}" Style="{StaticResource ModernButton}" Padding="14,7" Margin="0,0,8,0" Click="CollectionAdd_Click" />
                                    <Button Content="{Binding OpenText}" Style="{StaticResource SoftButton}" Padding="12,7" Margin="0,0,8,0" Click="CollectionOpen_Click" />
                                    <Button Content="{Binding RenameText}" Style="{StaticResource SoftButton}" Padding="12,7" Margin="0,0,8,0" Click="CollectionRename_Click" />
                                    <Button Content="{Binding DeleteText}" Style="{StaticResource SoftButton}" Padding="12,7" Click="CollectionDelete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="مجموعه‌ها" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Name="txtCollectionsTotal" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="12,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="خودت مجموعه بساز، یه اسم دلخواه بهش بده و فایل‌های کتاب رو توش بذار." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap" />
                <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button Name="btnCollectionNew" Style="{StaticResource ModernButton}" Padding="16,9" Click="btnCollectionNew_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlus}" StrokeThickness="2" />
                            <TextBlock Text="مجموعه‌ی جدید" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel Name="statusBarColl" Grid.Row="3" Margin="0,0,0,12" />
                <ListBox Name="collectionList" Grid.Row="4" Background="Transparent" BorderThickness="0" Padding="0,0,8,0" ItemContainerStyle="{StaticResource CollectionItemStyle}" ItemTemplate="{StaticResource CollectionRowTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" />
                <TextBlock Name="txtCollectionsEmpty" Grid.Row="4" Text="هنوز مجموعه‌ای نساختی. روی «مجموعه‌ی جدید» بزن." Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer Name="advancedPanel" Grid.Row="2" Style="{StaticResource ModernScrollViewer}" Margin="0,0,8,8" Visibility="Collapsed">
                <StackPanel Margin="36,8,36,28">
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Padding="4" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Name="btnAdvTabSmart" Tag="smart" Content="داشبورد هوشمند" Padding="12,7" FontSize="12" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Click="AdvSubTab_Click" />
                                <Button Name="btnAdvTabAutoScroll" Tag="autoscroll" Content="اسکرول خودکار" Padding="12,7" FontSize="12" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Click="AdvSubTab_Click" />
                                <Button Name="btnAdvTabPerf" Tag="perf" Content="عملکرد و روان‌سازی" Padding="12,7" FontSize="12" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Click="AdvSubTab_Click" />
                                <Button Name="btnAdvTabEyeCare" Tag="eyecare" Content="محافظ چشم و هوشمند" Padding="12,7" FontSize="12" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Click="AdvSubTab_Click" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="بخش پیشرفته و هوشمند" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="کنترل کامل اسکرول خودکار، بهینه‌سازی سرعت و ابزارهای هوشمند مطالعه" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- زیربخش ۱: داشبورد هوشمند -->
                    <StackPanel Name="pnlAdvSmart">
                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,14" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <DockPanel>
                                <Button Name="btnSmartRecOpen" DockPanel.Dock="Left" Content="ادامه مطالعه" Style="{StaticResource ModernButton}" Padding="18,10" VerticalAlignment="Center" Click="btnSmartRecOpen_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="✦ پیشنهاد هوشمند امروز" Foreground="{DynamicResource AccentColor}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Name="txtSmartRecTitle" Text="در حال تحلیل کتابخانه..." Foreground="{DynamicResource TextColor}" FontSize="18" FontWeight="Bold" Margin="0,6,0,4" />
                                    <TextBlock Name="txtSmartRecReason" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,14" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Name="txtSmartGoalSummary" DockPanel.Dock="Left" Text="۰ از ۳۰ دقیقه (۰٪)" Foreground="{DynamicResource AccentColor}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="هدف مطالعه‌ی روزانه" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold" />
                                </DockPanel>
                                <Border Height="8" Width="280" HorizontalAlignment="Right" CornerRadius="4" Background="{DynamicResource BorderColor}" ClipToBounds="True">
                                    <Border Name="barSmartGoalFill" Height="8" Width="8" HorizontalAlignment="Right" CornerRadius="4" Background="{DynamicResource AccentColor}" />
                                </Border>
                                <TextBlock Name="txtSmartStatusSummary" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- زیربخش ۲: اسکرول خودکار سراسری -->
                    <StackPanel Name="pnlAdvAutoScroll" Visibility="Collapsed">
                        <Border CornerRadius="16" Padding="20" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="اسکرول خودکار برای تمام فرمت‌ها (EPUB، PDF، کمیک CBZ، DOCX و TXT)" Foreground="{DynamicResource TextColor}" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock Text="تنظیمات پیش‌فرض اسکرول خودکار را اینجا تعیین کن تا در همه کتاب‌ها آماده باشد." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Name="btnAdvAsStep" Tag="step" Content="حالت زمان‌دار (مثلاً هر ۲ ثانیه)" Padding="14,8" Margin="0,0,8,0" Click="AdvAsMode_Click" />
                                    <Button Name="btnAdvAsSmooth" Tag="smooth" Content="حالت پیوسته (حرکت نرم مداوم)" Padding="14,8" Click="AdvAsMode_Click" />
                                </StackPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvAsIntervalVal" DockPanel.Dock="Left" Text="۲ ثانیه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="فاصله‌ی زمانی هر اسکرول (ثانیه)" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvAsInterval" Minimum="0.5" Maximum="30" Value="2" TickFrequency="0.5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,10" />
                                <WrapPanel Margin="0,0,0,16">
                                    <Button Content="۱ ثانیه" Tag="1" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                    <Button Content="۲ ثانیه" Tag="2" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                    <Button Content="۳ ثانیه" Tag="3" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                    <Button Content="۵ ثانیه" Tag="5" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                    <Button Content="۸ ثانیه" Tag="8" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                    <Button Content="۱۰ ثانیه" Tag="10" Style="{StaticResource SoftButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Click="AdvAsPreset_Click" />
                                </WrapPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvAsStepVal" DockPanel.Dock="Left" Text="۴۵٪ صفحه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="میزان اسکرول در هر گام زمان‌دار" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvAsStep" Minimum="15" Maximum="100" Value="45" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,16" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvAsSpeedVal" DockPanel.Dock="Left" Text="۴۵ پیکسل/ثانیه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="سرعت حالت اسکرول پیوسته (نرم)" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvAsSpeed" Minimum="15" Maximum="220" Value="45" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,16" />

                                <CheckBox Name="chkAdvAsAutoNext" Content="عبور خودکار به بخش یا صفحه‌ی بعدی هنگام رسیدن به انتهای صفحه" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,8" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                                <CheckBox Name="chkAdvAsPause" Content="توقف موقت هوشمند هنگام اسکرول دستی یا کلیک کاربر" Foreground="{DynamicResource TextColor}" FontSize="12.5" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- زیربخش ۳: عملکرد و روان‌سازی -->
                    <StackPanel Name="pnlAdvPerf" Visibility="Collapsed">
                        <Border CornerRadius="16" Padding="20" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="پروفایل بهینه‌سازی و روان‌سازی موتور برنامه" Foreground="{DynamicResource TextColor}" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Name="btnAdvPerfAuto" Tag="auto" Content="هوشمند (خودکار)" Padding="14,8" Margin="0,0,8,0" Click="AdvPerfProfile_Click" />
                                    <Button Name="btnAdvPerfTurbo" Tag="turbo" Content="توربو (حداکثر روانی)" Padding="14,8" Margin="0,0,8,0" Click="AdvPerfProfile_Click" />
                                    <Button Name="btnAdvPerfRich" Tag="rich" Content="حداکثر جلوه بصری" Padding="14,8" Click="AdvPerfProfile_Click" />
                                </StackPanel>

                                <CheckBox Name="chkAdvSmoothScroll" Content="اسکرول نرم با شتاب‌دهی سخت‌افزاری (Smooth Easing)" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,10" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                                <CheckBox Name="chkAdvCardAnim" Content="انیمیشن ورود و حرکت کارت‌های کتابخانه" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,10" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                                <CheckBox Name="chkAdvLazyImages" Content="بارگذاری تنبل تصاویر (کاهش مصرف رم در کتاب‌های حجیم)" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,10" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                                <CheckBox Name="chkAdvParticles" Content="جلوه‌ی ذرات پس‌زمینه‌ی تم‌ها" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,18" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Name="btnAdvClearCache" Content="پاکسازی کش و آزادسازی حافظه" Style="{StaticResource ModernButton}" Padding="16,9" Click="btnAdvClearCache_Click" />
                                    <TextBlock Name="txtAdvCacheStatus" Text="" Foreground="{DynamicResource AccentColor}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- زیربخش ۴: محافظ چشم و هوشمندسازی -->
                    <StackPanel Name="pnlAdvEyeCare" Visibility="Collapsed">
                        <Border CornerRadius="16" Padding="20" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="محافظ چشم و دستیار هوشمند مطالعه" Foreground="{DynamicResource TextColor}" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,14" />

                                <CheckBox Name="chkAdvAutoTheme" Content="تغییر خودکار تم روشن/تیره بر اساس ساعت شبانه‌روز (۷ صبح تا ۷ شب روشن)" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,14" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvEyeCareVal" DockPanel.Dock="Left" Text="۰٪" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="شدت فیلتر نور آبی (محافظ چشم)" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvEyeCare" Minimum="0" Maximum="60" Value="0" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvBrightnessVal" DockPanel.Dock="Left" Text="۱۰۰٪" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="روشنایی صفحه‌ی مطالعه" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvBrightness" Minimum="45" Maximum="100" Value="100" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,14" />

                                <CheckBox Name="chkAdvRuler" Content="فعال‌سازی پیش‌فرض خط‌کش تمرکز هوشمند در مطالعه" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,10" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />
                                <CheckBox Name="chkAdvEyeRest" Content="یادآور هوشمند استراحت چشم (قانون ۲۰-۲۰-۲۰)" Foreground="{DynamicResource TextColor}" FontSize="12.5" Margin="0,0,0,16" Checked="AdvCheck_Changed" Unchecked="AdvCheck_Changed" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvDailyGoalVal" DockPanel.Dock="Left" Text="۳۰ دقیقه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="هدف مطالعه‌ی روزانه" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvDailyGoal" Minimum="5" Maximum="180" Value="30" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvPomodoroVal" DockPanel.Dock="Left" Text="۲۵ دقیقه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="مدت هر جلسه‌ی پومودورو" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvPomodoro" Minimum="5" Maximum="60" Value="25" TickFrequency="5" ValueChanged="AdvSlider_ValueChanged" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Name="txtAdvWpmVal" DockPanel.Dock="Left" Text="۲۱۰ کلمه/دقیقه" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" />
                                    <TextBlock Text="سرعت مطالعه‌ی شخصی (برای تخمین دقیق زمان باقی‌مانده)" Foreground="{DynamicResource TextColor}" FontSize="13" />
                                </DockPanel>
                                <Slider Name="sldAdvWpm" Minimum="80" Maximum="500" Value="210" TickFrequency="10" ValueChanged="AdvSlider_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Name="dimOverlay" Grid.ColumnSpan="2" Background="#B30F0E17" Visibility="Collapsed" />
        <Grid Name="dropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="{DynamicResource BgDark}" Opacity="0.93" />
            <Rectangle Margin="28" RadiusX="24" RadiusY="24" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" StrokeDashArray="5 4" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IcoFile}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="2.8" ScaleY="2.8" />
                        </Path.LayoutTransform>
                    </Path>
                </Border>
                <TextBlock Text="فایل‌های کتاب رو اینجا رها کن" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="می‌تونی چند کتاب یا یه پوشه رو هم‌زمان بندازی" Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <Border Name="busyBar" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="22,14" CornerRadius="14" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="txtBusy" Foreground="{DynamicResource TextColor}" FontSize="13" VerticalAlignment="Center" />
                <ProgressBar Name="progressBusy" Style="{StaticResource ThinProgress}" Width="150" Height="5" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>